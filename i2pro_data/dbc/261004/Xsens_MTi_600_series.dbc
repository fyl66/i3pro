CM_ BU_ Xsens_Sensor "Generic Xsens Motion Sensor";
CM_ BO_ 3221225472 "This is a message for not used signals, created by Vector CANdb++ DBC OLE DB Provider.";
CM_ SG_ 17 SelfTestOk_MTI "Set when the self test result was ok";
CM_ SG_ 17 FilterValid_MTI "Set when the computed orientation is valid. The orientation may be invalid during startup or when the Xsens_Sensor data is clipping during violent (for the device) motion";
CM_ SG_ 17 GnssFix "Set when the device has a GNSS receiver and the receiver says that there is a GNSS position fix.";
CM_ SG_ 17 RepresentativeMotion_MTI "Indicates if the In-Run Compass Calibration is doing the representative motion analysis";
CM_ SG_ 17 ExternalClockSynced_MTI "Indicates whether the internal clock is synced with an external clock (Either GNSS or custom provided clock sync)";
CM_ SG_ 17 ClipAccX_MTI "Indicates if there was clipping on the X-axis of the accelerometer";
CM_ SG_ 17 ClipAccY_MTI "Indicates if there was clipping on the Y-axis of the accelerometer";
CM_ SG_ 17 ClipAccZ_MTI "Indicates if there was clipping on the Z-axis of the accelerometer";
CM_ SG_ 17 ClipGyrX_MTI "Indicates if there was clipping on the X-axis of the gyroscope";
CM_ SG_ 17 ClipGyrY_MTI "Indicates if there was clipping on the Y-axis of the gyroscope";
CM_ SG_ 17 ClipGyrZ_MTI "Indicates if there was clipping on the Z-axis of the gyroscope";
CM_ SG_ 17 ClipMagX_MTI "Indicates if there was clipping on the X-axis of the magnetometer";
CM_ SG_ 17 ClipMagY_MTI "Indicates if there was clipping on the Y-axis of the magnetometer";
CM_ SG_ 17 ClipMagZ_MTI "Indicates if there was clipping on the Z-axis of the magnetometer";
CM_ SG_ 17 ClippingDetected_MTI "When set Indicates clipping has occurred";
CM_ SG_ 17 SyncIn_MTI "When set indicates a sync-in event has been triggered";
CM_ SG_ 17 SyncOut_MTI "When set Indicates a sync-out event has been generated";
CM_ SG_ 17 FilterMode_MTI "Mask for the 3 bit filter mode field";
CM_ SG_ 17 HaveGnssTimePulse_MTI "Indicates that the 1PPS GNSS time pulse is present";
CM_ SG_ 17 RtkStatus_MTI "Mask for 2 bit RTK status field";
CM_ BO_ 7 "UTC Time in the following format YYMMDDhhmmss plus tenth of a milli second";
