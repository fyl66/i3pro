CM_ "STM32F103C8T6 + BMI088 -> ECU | CAN1 500kbps | StdId=0x7B(123) | ~200Hz";
CM_ BO_ 1923 "7字节双帧复用: byte0 = 帧类型(0x01 加速度 / 0x02 陀螺仪), 其余 6 字节为 3 轴 int16; 高字节在前(Motorola/Big-Endian)";
CM_ SG_ 1923 FrameType "帧类型标记: 1=加速度帧, 2=陀螺仪帧";
CM_ SG_ 1923 ACC_X "加速度 X 轴 (m/s^2), 量程 +/-6g, 1 LSB = 0.001795651245 m/s^2";
CM_ SG_ 1923 ACC_Y "加速度 Y 轴 (m/s^2), 量程 +/-6g";
CM_ SG_ 1923 ACC_Z "加速度 Z 轴 (m/s^2), 量程 +/-6g";
CM_ SG_ 1923 GYR_X "陀螺仪 X 轴 (dps), 量程 +/-500dps, 1 LSB = 0.015258789062 dps";
